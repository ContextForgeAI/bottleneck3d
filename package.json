{
  "name": "bottleneck3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bottleneck3D is a local-first interactive upgrade simulator for 3D printer owners.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:orca": "tsc -b && node scripts/build-orca-page.mjs",
    "start": "vite --open",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "compare": "node demo/compare-slicer.ts"
  },
  "keywords": [
    "3d-printing",
    "gcode",
    "klipper"
  ],
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
